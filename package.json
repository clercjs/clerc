{
  "name": "@clerc/monorepo",
  "private": true,
  "version": "1.3.1",
  "packageManager": "pnpm@12.21.0",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "bench": "vitest bench",
    "build": "tsdown",
    "docs:build": "pnpm -C docs build",
    "docs:dev": "pnpm -C docs dev",
    "docs:generate": "pnpm -C docs generate",
    "docs:preview": "pnpm -C docs preview",
    "lint": "eslint . && prettier . --check",
    "lint:fix": "eslint . --fix && prettier . --write",
    "prepublishOnly": "nr build",
    "release": "bumpp package.json packages/*/package.json --commit --push --tag",
    "test": "vitest",
    "test:all": "nr test && nr test:typecheck",
    "test:coverage": "vitest --coverage",
    "test:typecheck": "vitest --typecheck",
    "test:ui": "vitest --ui",
    "typecheck": "tsc && nr typecheck:docs",
    "typecheck:docs": "pnpm -C docs typecheck",
    "watch": "tsdown --watch"
  },
  "devDependencies": {
    "@antfu/ni": "catalog:dev",
    "@clerc/plugin-completions": "workspace:*",
    "@clerc/plugin-mcp": "workspace:*",
    "@clerc/test-utils": "workspace:*",
    "@so1ve/eslint-config": "catalog:lint",
    "@so1ve/prettier-config": "catalog:lint",
    "@types/node": "catalog:dev",
    "@vitest/coverage-istanbul": "catalog:dev",
    "@vitest/ui": "catalog:dev",
    "bumpp": "catalog:dev",
    "changelogithub": "catalog:dev",
    "clerc": "workspace:*",
    "eslint": "catalog:dev",
    "prettier": "catalog:dev",
    "tsdown": "catalog:dev",
    "typescript": "catalog:dev",
    "vite": "catalog:dev",
    "vitest": "catalog:dev"
  }
}
