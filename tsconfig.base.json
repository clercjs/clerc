{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext"],
    "moduleDetection": "force",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "types": ["node"],
    "strict": true,
    "strictNullChecks": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipDefaultLibCheck": true,
    "skipLibCheck": true,
    "paths": {
      "@clerc/*": ["./packages/*/src/index.ts"],
      "@clerc/logger/prompts": ["./packages/logger/src/prompts.ts"],
      "clerc": ["./packages/clerc/src/index.ts"],
      "clerc/prompts": ["./packages/clerc/src/prompts.ts"]
    }
  }
}
